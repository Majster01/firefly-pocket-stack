# firefly-pocket-stack configuration: every setting, and what it is for.
#
# A server keeps them in its settings store and never edits `.env` by hand
# (README "Settings"). The setup wizard asks for the few a person gives, checks
# them and generates the rest, the Firefly III tokens included (README "Set it up"):
#
#   scripts/firefly-pocket setup
#   scripts/firefly-pocket config set <KEY> <value>    # any one, later
#
# scripts/settings.json says how each value is checked and what its default is;
# CI keeps it and this file listing the same settings. A server set up before
# the store still has a `.env` copied from this file, edited by hand, until
# `scripts/firefly-pocket config import` moves it in. `.env` holds real secrets
# and is gitignored.
#
# Values are needed in two stages, because three of the services need a
# Firefly III Personal Access Token and those cannot exist until Firefly III
# is running and has its account. The wizard's account step makes both.

# ==========================================================================
# STAGE 1 — required before anything starts
# ==========================================================================

# --- Your domain ----------------------------------------------------------
# The stack answers on five names under it:
#   admin.<DOMAIN>     the Firefly Pocket Console: setup in the browser. Until
#                      Firefly III has its account, every other name sends the
#                      browser here, and it asks for the setup code
#   firefly.<DOMAIN>   Firefly III
#   app.<DOMAIN>       Firefly Pocket (compose service `next`)
#   import.<DOMAIN>    the importer's own UI, behind basic auth
#   legal.<DOMAIN>     the privacy policy and terms. Required as URLs on an
#                      Enable Banking production application, so this host has
#                      no basic auth (static text only). The same pages answer
#                      under https://app.<DOMAIN>/legal/ too.
# One wildcard DNS record, *.<DOMAIN>, pointing at this server covers them all.
# It must resolve BEFORE first start, or Caddy cannot obtain TLS certificates
# (README "Point DNS at it"). A subdomain of yours works the same way:
# DOMAIN=money.example.com gives app.money.example.com and so on.
DOMAIN=example.com
# Any name can be set on its own instead, e.g. to keep the one a server already
# uses: an installed Firefly Pocket belongs to its host, and moving it means
# adding the app again on every device. DOMAIN is not needed once these four are;
# without it, the console has no name until ADMIN_HOSTNAME is set (Caddy serves
# it as admin.localhost, which no one outside reaches by name).
#FIREFLY_HOSTNAME=firefly.example.com
#NEXT_HOSTNAME=next.example.com
#IMPORT_HOSTNAME=import.example.com
#LEGAL_HOSTNAME=legal.example.com
#ADMIN_HOSTNAME=admin.example.com
# Who the legal pages name as operator and data controller. Your own name:
# Enable Banking's reviewers read these pages. Empty: "The operator of this server".
LEGAL_OWNER_NAME=
# The contact address on the legal pages. Empty: SITE_OWNER (below).
LEGAL_CONTACT_EMAIL=
# The heading of the legal pages, e.g. your domain. Empty: the legal hostname.
LEGAL_SITE_NAME=
# There is no hostname for Dozzle, the log viewer: it is reached over an SSH
# tunnel only (README "Logs (Dozzle)").

# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# Leave EMPTY for real (trusted) certificates from Let's Encrypt production.
# On a first deploy, or after changing DNS/firewall, set this to the staging
# directory first — staging certs are untrusted but its rate limits are far
# higher, so a misconfiguration costs nothing. Production allows only 5
# failures per hostname per hour.
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Clear it and recreate Caddy to get trusted certs.
ACME_CA=

# Firefly III administrator address.
SITE_OWNER=you@example.com

# IANA timezone. Governs when the cron jobs actually run.
TZ=Europe/Ljubljana

# --- Basic auth for the importer UI --------------------------------------
# The importer has no login of its own, so Caddy guards it.
# IMPORT_AUTH_HASH is a bcrypt hash written by gen-secrets.sh.
#
# It contains `$` characters, which Docker Compose would try to interpret,
# so they are stored DOUBLED (`$$`). Compose unescapes them back to a single
# `$` before Caddy sees the value. gen-secrets.sh handles this for you —
# if you ever regenerate the hash by hand, remember to double the `$`.
IMPORT_AUTH_USER=admin
IMPORT_AUTH_HASH=

# --- Generated secrets (gen-secrets.sh fills these) -----------------------
# APP_KEY and STATIC_CRON_TOKEN must be EXACTLY 32 characters.
FIREFLY_APP_KEY=
STATIC_CRON_TOKEN=
AUTO_IMPORT_SECRET=
POSTGRES_SUPER_PASSWORD=
FIREFLY_DB_PASSWORD=
# The importer fork stores bank connections in its own database; its APP_KEY
# encrypts their Enable Banking sessions. FIREFLYX_API_TOKEN is what
# Firefly Pocket sends to the fork's API (and the fork refuses anything under 32 characters).
IMPORTER_DB_PASSWORD=
IMPORTER_APP_KEY=
FIREFLYX_API_TOKEN=
# Firefly Pocket: its APP_KEY, its own database's password, and the token of its
# internal Web Push endpoint, which this stack's alert senders (scripts/lib.sh, the
# category suggester) send to; at least 32 characters.
NEXT_APP_KEY=
NEXT_DB_PASSWORD=
NEXT_NOTIFY_TOKEN=
# The code the console on admin.<DOMAIN> asks for until setup is finished, made
# by `scripts/firefly-pocket setup web` (not gen-secrets.sh), which prints it.
# Sixteen characters of Crockford's base32 in groups of four: 80 bits.
SETUP_CODE=
# The console's "Sign in with Firefly III" client, once setup has made the
# account: registered inside Firefly III by scripts/firefly-bootstrap.php (no
# secret: PKCE stands in for one). Not set by hand.
CONSOLE_CLIENT_ID=
# Firefly Pocket's "Sign in with Firefly III" client, registered the same way.
# Not set by hand; empty, Firefly Pocket asks for a pasted token instead.
POCKET_CLIENT_ID=

# --- Registration ---------------------------------------------------------
# Nothing to set. Firefly III 6.x has no ALLOW_REGISTRATION option; it closes
# signups automatically once the first account exists (`single_user_mode`,
# stored in the database, defaults to true). Verified against 6.6.6: after
# registering, /register shows "Registration is currently not available".
# The setup wizard makes the account before anything is public, and checks it;
# a setup started in the browser keeps every name behind the console until then
# (the Caddyfile's setup gate).

# ==========================================================================
# STAGE 2 — once Firefly III has its account
# ==========================================================================
# Personal Access Tokens, one per app so any one can be revoked alone (Firefly
# III -> Options -> Profile -> OAuth). `scripts/firefly-pocket setup account`
# makes them inside Firefly III: "Firefly Pocket importer", "... suggester" and
# "... warm-up". Made by hand, they are pasted with config set <KEY> -.

IMPORTER_FIREFLY_TOKEN=
# Firefly Pocket's token is NOT set here — you paste it into Firefly Pocket
# itself, in the browser.

# A Firefly III token of your own user, with which Firefly Pocket refetches
# Home after a change so the first open finds it cached (its README, "Caching").
# Its own token, so it can be revoked alone. Empty = off.
NEXT_WARMUP_FIREFLY_TOKEN=

# --- Enable Banking (EU/EEA bank connection) ------------------------------
# `scripts/firefly-pocket setup bank` makes the key and a certificate for the
# application you register in the Enable Banking control panel, then takes its
# ID. A PEM made there instead goes in with scripts/set-eb-key.sh.
# Check your bank is in their coverage before relying on this.
#
# Redirect URLs to register in their portal, exactly so (no trailing slash):
#   https://app.<DOMAIN>/eb-callback      linking a bank from Firefly Pocket
#   https://import.<DOMAIN>/eb-callback   linking one in the importer's own UI
# (your NEXT_HOSTNAME and IMPORT_HOSTNAME, where you set those).
#
# ENABLE_BANKING_PRIVATE_KEY must be the base64 BODY of that PEM on ONE line —
# armour stripped, newlines removed. The importer detects base64 and rebuilds
# the PEM itself. A path or file:// URL is REJECTED ("Private key is an URL")
# and the UI shows only a bare "NOK". Produce the value with:
#   grep -v -- ----- compose/secrets/eb/private.pem | tr -d '\n'
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# How many days back each nightly import asks the bank for.
#
# 1 would be a literal "last 24 hours", but banks routinely book a transaction
# a day or two after it happened, and no later run looks back far enough to
# pick those up — they would be missed permanently. The overlap is free:
# duplicate detection discards it (and IGNORE_DUPLICATE_ERRORS keeps it out of
# the logs). Raise it if you ever see transactions arrive late anyway.
#
# NOTE: applied by the importer fork's `fireflyx:render`, which writes a
# concrete date_not_before into every connection's config before each run.
# One date is computed for all of them, so every bank account shares exactly the
# same window. The importer does NOT recompute a relative range on its own —
# see the runbook in README.
IMPORT_LOOKBACK_DAYS=5

# --- Status page in Firefly Pocket -----------------------------------------
# How many days of per-night import history the importer keeps for Firefly
# Pocket's System status page, and the error messages of each of them for the
# Import errors page. Older rows are deleted as new ones come in; the errors of
# "Import now" imports are not pruned.
FIREFLYX_HISTORY_DAYS=180
# The same for bank connection events (consent steps, declined / failed
# links, refreshes that failed, consents that ended).
FIREFLYX_EVENTS_DAYS=90

# --- Debugging a bank link ---------------------------------------------------
# true: the importer logs every step of a consent (what it asks Enable Banking,
# what comes back to the callback, what the session holds) as "EB-TRACE" lines.
# IBANs and names are masked; _RAW=true logs Enable Banking's answers as they
# are, so use it only while debugging and switch it off again.
FIREFLYX_EB_TRACE=false
FIREFLYX_EB_TRACE_RAW=false

# --- Category suggester ---------------------------------------------------
# Suggests category rules for uncategorized withdrawals; you approve them in
# Firefly Pocket. It only ever writes INACTIVE rules into the `Suggestions` rule group.
#
# Its own Personal Access Token, so it can be revoked alone.
SUGGESTER_FIREFLY_TOKEN=
# From console.anthropic.com -> API keys. The account needs credit: an empty
# balance fails every call with "credit balance is too low".
ANTHROPIC_API_KEY=
# Only needed if SUGGESTER_MODEL is a gemini-* model (needs a paid Gemini
# project: the free tier allows 20 requests a day and no search).
GEMINI_API_KEY=
# claude-* uses ANTHROPIC_API_KEY; gemini-* uses GEMINI_API_KEY.
SUGGESTER_MODEL=claude-haiku-5-5
# Below this the suggestion is still made, but flagged low-confidence and
# limited to the exact transaction description as its only trigger.
SUGGESTER_MIN_CONFIDENCE=0.6
# Most suggestions one run may write — a ceiling on a bad night, not a target.
SUGGESTER_MAX_PER_RUN=50
# Shared by the importer and the suggester-trigger service (never leaves the
# compose network): lets "Import now" in Firefly Pocket be followed by suggestions for the
# time frame it imported. gen-secrets.sh generates it; at least 32 characters.
SUGGESTER_TRIGGER_TOKEN=

# ==========================================================================
# Alerting and backups
# ==========================================================================

# Where nightly alerts go. Any ntfy topic URL, or leave blank to disable.
# A silent failure is this system's most likely failure mode — set this.
# Stays the fallback when Web Push (below) is on: every alert goes to both.
NTFY_URL=

# --- Dead man's switch ------------------------------------------------------
# Every alert here is sent FROM this machine, so when it is down or cron has
# stopped, nothing alerts at all. Create one check per job at healthchecks.io
# (free tier is plenty; any service with its URL scheme works), set its
# schedule, and paste its ping URL. The service alerts you when a ping does not
# arrive on time, and when a run reports failure. Leave blank to disable.
#   HEALTHCHECK_NIGHTLY_URL   cron "0 3 * * *", timezone = TZ above, grace 1h
#   HEALTHCHECK_BACKUP_URL    cron "0 2 * * *", timezone = TZ above, grace 1h
# A backup that never left this machine (RESTIC_REPOSITORY empty) reports as
# failed on purpose.
HEALTHCHECK_NIGHTLY_URL=
HEALTHCHECK_BACKUP_URL=

# --- Deploys (scripts/deploy.sh, used by scripts/, not by compose) ---------
# Optional. A fine-grained GitHub token for the firefly-pocket-stack repository only, with
# "Commit statuses: Read and write": every deploy then shows on its commit in
# GitHub as a deploy/server status. Empty: no status; deploys work the same.
DEPLOY_STATUS_TOKEN=

# --- Web Push to the Firefly Pocket app ---------------------------------------------
# Alerts also arrive as native notifications in the installed Firefly Pocket PWA. Needs
# NEXT_NOTIFY_TOKEN (above) and a VAPID keypair; see README "Push alerts".
# gen-secrets.sh generates the keypair with openssl (P-256, base64url, the
# public key uncompressed). VAPID_SUBJECT is a mailto: address the push services
# can reach you at; replace the placeholder with yours.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Offsite backups (used by scripts/, not by compose) -------------------

# restic offsite backup repository, e.g.
#   s3:s3.eu-central-003.backblazeb2.com/your-bucket
#   sftp:u123456@u123456.your-storagebox.de:/backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# For S3/B2 targets:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
