#!/usr/bin/env bash
#
# The server's command line.
#
#     scripts/firefly-pocket setup [<step>]   the setup wizard (scripts/setup.sh says how)
#     scripts/firefly-pocket setup web        the same in a browser, on admin.<domain>
#     scripts/firefly-pocket config ...       the settings (scripts/config.sh says how)
#     scripts/firefly-pocket console ...      the console's host side (scripts/console.sh says how)
#     scripts/firefly-pocket tokens [rotate]  the apps' Firefly III tokens (scripts/tokens.sh says how)

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  setup) shift; exec "$here/setup.sh" "$@" ;;
  config) shift; exec "$here/config.sh" "$@" ;;
  console) shift; exec "$here/console.sh" "$@" ;;
  tokens) shift; exec "$here/tokens.sh" "$@" ;;
  *)
    echo "usage: scripts/firefly-pocket setup [<step>|web]" >&2
    echo "       scripts/firefly-pocket config <list|get|set|unset|has|check|render|import> ..." >&2
    echo "       scripts/firefly-pocket console <apply|status|install|client|expire>" >&2
    echo "       scripts/firefly-pocket tokens [rotate [--days N]]" >&2
    exit 2
    ;;
esac
